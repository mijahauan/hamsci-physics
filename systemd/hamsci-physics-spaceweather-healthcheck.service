[Unit]
Description=HF-TimeStd Space-Weather Health Check
Documentation=https://github.com/HamSCI/hamsci-physics
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=timestd
Group=timestd

# Operator identity (callsign, grid) from sigmond — CLIENT-CONTRACT §14.2
EnvironmentFile=-/etc/sigmond/coordination.env
EnvironmentFile=-/etc/hamsci-physics/environment

ExecStart=/opt/git/sigmond/hamsci-physics/scripts/spaceweather-healthcheck.sh

TimeoutStartSec=60

StandardOutput=journal
StandardError=journal
SyslogIdentifier=hamsci-physics-spaceweather-healthcheck

# Hardening: read-only; the script only reads the iono cache and curls SWPC.
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
