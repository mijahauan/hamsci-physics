# hamsci-physics configuration
#
# Installed to /etc/hamsci-physics/config.toml.  The [station] block is
# deliberately identical in shape to hf-timestd's and mag-recorder's: one
# station identity, repeated per component, so a component can be installed
# or removed without editing another's config.  `smd config init
# hamsci-physics` fills it from the station-wide values.

[station]
# Amateur callsign and Maidenhead grid — used for GRAPE dataset metadata.
callsign         = ""
grid_square      = ""
# PSWS station id (e.g. "S000170") and the GRAPE instrument id (e.g. "171").
# Leave psws_station_id empty to run the science locally without uploading.
psws_station_id  = ""
instrument_id    = ""

[paths]
# The timing core's data root.  This is a FROZEN CONTRACT of the 2026-08-24
# split: hamsci-physics reads hf-timestd's products in place rather than
# copying them, so this must match hf-timestd's [paths].data_root.
data_root        = "/var/lib/timestd"

[grape]
# Daily pipeline: decimate → spectrogram → package → upload.
enabled          = true
# Skip the upload stage (science still runs, datasets stay local).
upload           = true

[reanalysis]
# Offline re-solve of a day's arrivals into TEC/dTEC products.
enabled          = true

[fusion]
# L3 physics fusion service (hamsci-physics-fusion.service): carrier-phase
# and differential dTEC, GNSS-VTEC anchored.  This is a live product — it
# runs every minute — so it defaults ON.
enabled          = true

[storage]
# Data-product store.  Empty = the shared default under data_root, which is
# what the timing core writes and what every reader expects.
sqlite_path      = ""
